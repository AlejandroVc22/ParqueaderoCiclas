server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # No cachear env.js para que las URLs se actualicen al instante en redeploys.
    location = /env.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Servir todos los assets estáticos y el SPA fallback con una sola location.
    # Nginx intenta servir el archivo exacto y si no existe, devuelve index.html
    # (necesario para rutas SPA como /dashboard, /bicicletas, etc.).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
