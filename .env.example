# ===============================================
# Variables globales del docker-compose
# Renombra este archivo a .env si quieres usarlas
# ===============================================

# JWT compartido por ambos microservicios (debe ser idéntico)
JWT_SECRET=ciclo-parqueadero-super-secret-key-change-in-production-please
JWT_EXPIRATION_MS=86400000

# PostgreSQL (Auth)
POSTGRES_DB=auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MySQL (Parqueadero)
MYSQL_DATABASE=parqueadero_db
MYSQL_ROOT_PASSWORD=root

# Admin sembrado al iniciar auth-service
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@cicloparqueadero.com
ADMIN_PASSWORD=Admin123!
