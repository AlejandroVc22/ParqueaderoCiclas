# ===============================================
# Variables globales del docker-compose
# Renombra este archivo a .env si quieres usarlas
# ===============================================

# JWT compartido por ambos microservicios
JWT_SECRET=ciclo-parqueadero-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# PostgreSQL (microservicio Auth)
POSTGRES_DB=auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MySQL (microservicio Parqueadero)
MYSQL_DATABASE=parqueadero_db
MYSQL_ROOT_PASSWORD=root

# Admin sembrado al iniciar auth-service
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@cicloparqueadero.com
ADMIN_PASSWORD=Admin123!

# URLs que el frontend usará en runtime para llamar a los microservicios
# (cuando se accede desde el navegador, usa localhost)
AUTH_API_URL=http://localhost:4001
PARQUEADERO_API_URL=http://localhost:4002
